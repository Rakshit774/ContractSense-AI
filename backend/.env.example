# ── ContractSenseAI · Backend Environment Variables ──────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Groq API (get free key at console.groq.com)
GROQ_API_KEY=gsk_paste_your_key_here

# JWT Secret — change to a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-string

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./contractsense.db
# DATABASE_URL=postgresql://user:password@localhost/contractsense
